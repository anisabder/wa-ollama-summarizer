# Optional: start the bot automatically when you log in.
# Copy to ~/.config/systemd/user/wa-summarizer.service, fix the two paths, then:
#   systemctl --user daemon-reload
#   systemctl --user enable --now wa-summarizer
#   journalctl --user -u wa-summarizer -f      (watch the logs)
[Unit]
Description=WhatsApp Ollama summarizer
After=network-online.target

[Service]
WorkingDirectory=%h/wa-ollama-summarizer
# Use the output of `which node` here (mise installs it outside /usr/bin)
ExecStart=/usr/bin/node src/index.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
