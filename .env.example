# Copy to .env and change what you need. Everything is optional.

# Ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT_MS=600000

# Long chats are split into chunks of this many characters, summarized one by one, then merged
CHUNK_CHARS=7000

# !summarize without a number uses DEFAULT_COUNT; numbers above MAX_COUNT are capped
DEFAULT_COUNT=50
MAX_COUNT=500

# Leave empty to write the summary in the chat's main language, or force one (e.g. English, French)
SUMMARY_LANGUAGE=

# Link with a code instead of a QR: digits only with country code, no + sign
PAIRING_PHONE=

# Browser used to run WhatsApp Web. Leave empty to auto-detect /usr/bin/chromium
CHROME_PATH=

# On startup the bot reads recent messages from your most recent chats so it has history
BACKFILL_CHATS=30
BACKFILL_MESSAGES=100

# Only if WhatsApp Web changes and the bot gets stuck loading: pin a version from the wppconnect-team/wa-version repo, including the suffix, e.g. 2.3000.1050732206-alpha
WA_WEB_VERSION=

DB_PATH=./data/messages.db
AUTH_DIR=./auth

# Print every message event and why messages are skipped (true/false)
DEBUG=false
